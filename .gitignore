# CS 131 project — capture data, intrinsics, reconstructions, model weights
# (per proposal: gitignore raw captures, frames, intrinsics, COLMAP outputs, SAM checkpoints)
data/captures/*
!data/captures/.gitkeep
data/frames/*
!data/frames/.gitkeep
data/calibration/*
!data/calibration/.gitkeep

outputs/reconstructions/*
!outputs/reconstructions/.gitkeep

# SAM checkpoints — large model weights
*.pth
*.pt
checkpoints/

# COLMAP working dirs
colmap_workspace/
sparse/
dense/
database.db
.claude/

# Notebook-local working dirs created when a notebook runs from inside the
# notebooks/ directory without setting PROJECT_ROOT first.
notebooks/data/
notebooks/outputs/
